  "textos": {
   "ca": [
    "Es va deixar caure sobre el carro.",
    "Tenia un forn a la mateixa fila.",
    "Tenia una paret exterior de la finca just al costat.",
    "Compartia habitació amb Berta.",
    "Compartia fila amb un armari.",
    "Una bàscula era a la seva fila.",
    "Estava vora una pica.",
    "Respecte a Dídac, estava a un moviment de cavall.",
    "Prop seu hi havia un forn.",
    "Només hi havia una persona a l'hort, víctima inclosa.",
    "Era a l'est de Dídac.",
    "No es trobava al celler.",
    "Estava més a l'est que Enric."
   ],
   "fr": [
    "Elle se tenait sur la charrette.",
    "Sur sa ligne se trouvait un four.",
    "Il avait un mur extérieur de la propriété tout contre lui.",
    "Berta et lui étaient dans la même pièce.",
    "Une armoire se trouvait sur sa ligne.",
    "Il partageait sa ligne avec une balance.",
    "Il était à côté d'un évier.",
    "Elle se trouvait à un saut de cavalier de Dídac.",
    "Il avait un four tout près.",
    "Il n'y avait qu'une personne dans le potager, victime comprise.",
    "Dídac était à l'ouest de lui.",
    "Personne ne l'a vu dans le cellier.",
    "Elle était à l'est d'Enric."
   ]
