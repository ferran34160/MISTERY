  "textos": {
   "ca": [
    "Era al sud d'Eulàlia.",
    "Compartia fila amb una bàscula.",
    "Un carro era a la seva columna.",
    "Era a un salt de cavall de Cesc (com als escacs).",
    "Un carro era a la seva fila.",
    "Estava més a l'est que David.",
    "Estava més al nord que Francesca.",
    "Era a l'oest de Bruna.",
    "A la seva fila hi havia un pou.",
    "A la seva columna hi havia un carro.",
    "Compartia habitació amb Guerau.",
    "Era a la mateixa diagonal que Bruna."
   ],
   "fr": [
    "Eulàlia était au nord de lui.",
    "Elle partageait sa ligne avec une balance.",
    "Une charrette se trouvait dans sa colonne.",
    "Elle se trouvait à un saut de cavalier de Cesc.",
    "Sur sa ligne se trouvait une charrette.",
    "Elle était à l'est de David.",
    "Francesca était au sud de lui.",
    "Bruna était à l'est d'elle.",
    "Un puits se trouvait sur sa ligne.",
    "Il partageait sa colonne avec une charrette.",
    "Guerau et lui étaient dans la même pièce.",
    "Elle partageait une diagonale avec Bruna."
   ]
