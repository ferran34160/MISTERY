  "textos": {
   "ca": [
    "Tenia Dídac al seu oest.",
    "Tenia un armari a la mateixa fila.",
    "A la seva fila hi havia un tractor.",
    "Era al costat d'un armari.",
    "Era al nord d'Aleix.",
    "A la seva columna hi havia un rac de vins.",
    "Un pou era a la seva columna.",
    "Compartia habitació amb Eulàlia.",
    "A la seva habitació només hi havia Fabiola amb ell.",
    "No era al porxo."
   ],
   "fr": [
    "Il se trouvait plus à l'est que Dídac.",
    "Sur sa ligne se trouvait une armoire.",
    "Un tracteur se trouvait sur sa ligne.",
    "Il se tenait près d'une armoire.",
    "Elle était au nord d'Aleix.",
    "Elle partageait sa colonne avec un casier à vins.",
    "Dans sa colonne se trouvait un puits.",
    "Eulàlia et lui étaient dans la même pièce.",
    "Il ne partageait sa pièce qu'avec Fabiola.",
    "Il ne se trouvait pas dans le porche."
   ]
