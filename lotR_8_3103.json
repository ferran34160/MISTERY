  "textos": {
   "ca": [
    "Tenia Enric al seu nord.",
    "Tenia una bàscula a la mateixa fila.",
    "Compartia columna amb un carro.",
    "Respecte a Clara, estava a un moviment de cavall.",
    "Compartia fila amb un carro.",
    "Tenia Dídac al seu oest.",
    "Tenia Francesca al seu sud.",
    "Estava més a l'oest que Biel.",
    "Un pou era a la seva fila.",
    "Tenia un carro a la mateixa columna.",
    "Compartia habitació amb Griselda.",
    "Compartia diagonal amb Biel."
   ],
   "fr": [
    "Enric était au nord de lui.",
    "Il partageait sa ligne avec une balance.",
    "Dans sa colonne se trouvait une charrette.",
    "Par rapport à Clara, il était à un mouvement de cavalier.",
    "Sur sa ligne se trouvait une charrette.",
    "Il se trouvait plus à l'est que Dídac.",
    "Il se trouvait plus au nord que Francesca.",
    "Elle était à l'ouest de Biel.",
    "Un puits se trouvait sur sa ligne.",
    "Il partageait sa colonne avec une charrette.",
    "Il partageait sa pièce avec Griselda.",
    "Il était sur la même diagonale que Biel."
   ]
