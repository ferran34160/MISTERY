  "textos": {
   "ca": [
    "A la seva fila hi havia una cadira.",
    "Era a la mateixa diagonal que Delfina.",
    "Era a un salt de cavall de Delfina (com als escacs).",
    "Era al costat d'una cadira.",
    "A la seva fila hi havia un balancí.",
    "A la seva columna hi havia un carro.",
    "A la seva columna hi havia una figuera.",
    "Era a un salt de cavall de Carles (com als escacs).",
    "No era a la mateixa habitació que Carles.",
    "Era a l'oest d'Eudald.",
    "Era en un racó d'una habitació."
   ],
   "fr": [
    "Sur sa ligne se trouvait une chaise.",
    "Il était sur la même diagonale que Delfina.",
    "Elle était à un saut de cavalier de Delfina (comme aux échecs).",
    "Il était à côté d'une chaise.",
    "Sur sa ligne se trouvait un fauteuil à bascule.",
    "Dans sa colonne se trouvait une charrette.",
    "Dans sa colonne se trouvait un figuier.",
    "Elle était à un saut de cavalier de Carles (comme aux échecs).",
    "Il n'était pas dans la même pièce que Carles.",
    "Elle était à l'ouest d'Eudald.",
    "Il était dans un coin d'une pièce."
   ]
