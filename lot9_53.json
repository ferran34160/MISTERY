  "textos": {
   "ca": [
    "Era a l'est de Remei.",
    "Era al nord de Teo.",
    "Era al costat d'un banc.",
    "A la seva fila hi havia un carro.",
    "A la seva columna hi havia un pou.",
    "Era a l'oest de Quim.",
    "A la seva fila hi havia un banc.",
    "A la seva columna hi havia un carro.",
    "Era a la mateixa diagonal que Elna.",
    "Era al nord d'Aina.",
    "Era a la mateixa habitació que Neus.",
    "A la seva fila hi havia una llar de foc.",
    "A la seva columna hi havia una llar de foc.",
    "Només hi havia una persona a l'hort, víctima inclosa."
   ],
   "fr": [
    "Elle était à l'est de Remei.",
    "Elle était au nord de Teo.",
    "Il avait un banc tout près.",
    "Sur sa ligne se trouvait une charrette.",
    "Dans sa colonne se trouvait un puits.",
    "Elle était à l'ouest de Quim.",
    "Sur sa ligne se trouvait un banc.",
    "Dans sa colonne se trouvait une charrette.",
    "Il était sur la même diagonale qu'Elna.",
    "Elle était au nord d'Aina.",
    "Elle était dans la même pièce que Neus.",
    "Sur sa ligne se trouvait une cheminée.",
    "Dans sa colonne se trouvait une cheminée.",
    "Il n'y avait qu'une personne dans le potager, victime comprise."
   ]
