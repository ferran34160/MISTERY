  "textos": {
   "ca": [
    "Tenia una taula a tocar.",
    "Només ell i Remei eren a la seva habitació.",
    "No era a la cuina.",
    "Era a l'oest de Rosa.",
    "Era al nord de Neus.",
    "Tenia un pou a tocar.",
    "A la seva fila hi havia un pou.",
    "Era a la mateixa habitació que Aina.",
    "Era a l'oest de Teo.",
    "Era a la mateixa diagonal que Jaume.",
    "Era a l'est de Remei.",
    "Era al sud d'Aina."
   ],
   "fr": [
    "Elle était à côté d'une table.",
    "Seuls lui et Remei étaient dans sa pièce.",
    "Il n'était pas dans la cuisine.",
    "Elle était à l'ouest de Rosa.",
    "Elle était au nord de Neus.",
    "Il avait un puits tout près.",
    "Sur sa ligne se trouvait un puits.",
    "Il était dans la même pièce qu'Aina.",
    "Elle était à l'ouest de Teo.",
    "Elle était sur la même diagonale que Jaume.",
    "Elle était à l'est de Remei.",
    "Il était au sud d'Aina."
   ]
