  "textos": {
   "ca": [
    "Un armari era a la seva fila.",
    "Prop seu hi havia una llar de foc.",
    "Compartia fila amb un balancí.",
    "Tocava una paret exterior de la finca.",
    "Tenia Aina al seu est.",
    "Era a un salt de cavall d'Helena (com als escacs).",
    "Tenia un carro a la mateixa fila.",
    "Compartia columna amb una taula.",
    "Tenia un armari a tocar.",
    "La sala només tenia una persona, comptant la víctima.",
    "Era al nord de Carla.",
    "Estava més a l'oest que Helena."
   ],
   "fr": [
    "Elle partageait sa ligne avec une armoire.",
    "Il était à côté d'une cheminée.",
    "Sur sa ligne se trouvait un fauteuil à bascule.",
    "Elle touchait un mur extérieur de la propriété.",
    "Aina était à l'est d'elle.",
    "Elle était à un saut de cavalier d'Helena (comme aux échecs).",
    "Une charrette se trouvait sur sa ligne.",
    "Il partageait sa colonne avec une table.",
    "Il se tenait près d'une armoire.",
    "Il n'y avait qu'une personne dans le salon, victime comprise.",
    "Carla était au sud d'elle.",
    "Elle était à l'ouest d'Helena."
   ]
