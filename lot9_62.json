  "textos": {
   "ca": [
    "Estava més al sud que Dídac.",
    "Tenia Felip al seu nord.",
    "Compartia fila amb una taula.",
    "Compartia columna amb una figuera.",
    "Era al nord de Felip.",
    "A la seva columna hi havia un pou.",
    "Va quedar-se sobre la cadira.",
    "El corral estava buida: ni un sol cos.",
    "Estava més a l'oest que Elna.",
    "Es trobava a la sala.",
    "Prop seu hi havia un balancí.",
    "A la seva habitació només hi havia Felip amb ella.",
    "Era a la mateixa diagonal que Helena."
   ],
   "fr": [
    "Elle se trouvait plus au sud que Dídac.",
    "Felip était au nord de lui.",
    "Sur sa ligne se trouvait une table.",
    "Un figuier se trouvait dans sa colonne.",
    "Il était au nord de Felip.",
    "Dans sa colonne se trouvait un puits.",
    "Il était installé sur la chaise.",
    "Pas âme qui vive dans la basse-cour, la victime non plus.",
    "Elna était à l'est de lui.",
    "Elle se trouvait dans le salon.",
    "Elle avait un fauteuil à bascule tout près.",
    "Seuls elle et Felip étaient dans sa pièce.",
    "Il partageait une diagonale avec Helena."
   ]
