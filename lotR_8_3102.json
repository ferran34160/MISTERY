   "ca": [
    "Era al costat d'un tractor.",
    "Un banc era a la seva fila.",
    "Va quedar-se sobre el balancí.",
    "Només ella i Guerau eren a la seva habitació.",
    "Tenia Fanny al seu oest.",
    "Era a l'hort.",
    "Tenia Arnau al seu sud.",
    "Era a la mateixa diagonal que Fanny.",
    "Tenia una cadira a tocar.",
    "Estava més a l'est que Elna.",
    "Tenia Guerau al seu est."
   ],
   "fr": [
    "Elle se tenait près d'un tracteur.",
    "Un banc se trouvait sur sa ligne.",
    "Il se tenait sur le fauteuil à bascule.",
    "Dans sa pièce, il n'y avait qu'elle et Guerau.",
    "Elle était à l'est de Fanny.",
    "On l'a vue dans le potager.",
    "Elle se trouvait plus au nord qu'Arnau.",
    "Il était sur la même diagonale que Fanny.",
    "Il avait une chaise tout près.",
    "Elle se trouvait plus à l'est qu'Elna.",
    "Elle se trouvait plus à l'ouest que Guerau."
   ]
