   "ca": [
    "Era al costat d'un tractor.",
    "Tenia un banc a la mateixa fila.",
    "Era sobre el balancí.",
    "Només ella i Gemma eren a la seva habitació.",
    "Estava més a l'est que Fanny.",
    "Era a l'hort.",
    "Era al nord d'Aina.",
    "Era a la mateixa diagonal que Fanny.",
    "Tenia una cadira a tocar.",
    "Era a l'est d'Eulàlia.",
    "Era a l'oest de Gemma."
   ],
   "fr": [
    "Elle se tenait près d'un tracteur.",
    "Elle partageait sa ligne avec un banc.",
    "Elle était installée sur le fauteuil à bascule.",
    "Elle ne partageait sa pièce qu'avec Gemma.",
    "Il se trouvait plus à l'est que Fanny.",
    "Elle se trouvait dans le potager.",
    "Aina était au sud d'elle.",
    "Elle partageait une diagonale avec Fanny.",
    "Il était à côté d'une chaise.",
    "Elle était à l'est d'Eulàlia.",
    "Gemma était à l'est d'elle."
