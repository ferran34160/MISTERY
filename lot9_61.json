  "textos": {
   "ca": [
    "La van veure a l'hort.",
    "Era a la mateixa habitació que Carla.",
    "Era al costat d'una paret exterior de la finca.",
    "Tenia un carro a la mateixa columna.",
    "Tenia Fanny al seu oest.",
    "Compartia habitació només amb Guerau.",
    "Compartia fila amb un armari.",
    "Tenia Arnau al seu sud.",
    "A la seva columna hi havia un barril.",
    "Compartia diagonal amb Guerau.",
    "Estava al porxo.",
    "Estava vora un carro.",
    "Era al nord d'Hug.",
    "Era a la mateixa diagonal que Dolors."
   ],
   "fr": [
    "Elle se trouvait dans le potager.",
    "Il partageait sa pièce avec Carla.",
    "Il touchait un mur extérieur de la propriété.",
    "Dans sa colonne se trouvait une charrette.",
    "Fanny était à l'ouest d'elle.",
    "Dans sa pièce, il n'y avait qu'elle et Guerau.",
    "Une armoire se trouvait sur sa ligne.",
    "Elle était au nord d'Arnau.",
    "Il partageait sa colonne avec un tonneau.",
    "Il partageait une diagonale avec Guerau.",
    "On l'a vu dans le porche.",
    "Il avait une charrette tout près.",
    "Elle se trouvait plus au nord qu'Hug.",
    "Il était sur la même diagonale que Dolors."
   ]
