  "textos": {
   "ca": [
    "El van veure al corral.",
    "Tenia Guerau al seu oest.",
    "A la seva fila hi havia un armari.",
    "Tenia Aina al seu est.",
    "Es va deixar caure sobre el carro.",
    "Bruna i ella eren a la mateixa habitació.",
    "Era al nord de Clara.",
    "Compartia fila amb un armari.",
    "A la seva habitació només hi havia Clara amb ella.",
    "Tocava una paret exterior de la finca.",
    "Fabiola i ella eren en una mateixa línia diagonal.",
    "Compartia diagonal amb Bruna.",
    "A la seva columna hi havia una bicicleta."
   ],
   "fr": [
    "Il a passé le temps dans la basse-cour.",
    "Elle était à l'est de Guerau.",
    "Une armoire se trouvait sur sa ligne.",
    "Elle était à l'ouest d'Aina.",
    "Elle se tenait sur la charrette.",
    "Elle partageait sa pièce avec Bruna.",
    "Il se trouvait plus au nord que Clara.",
    "Sur sa ligne se trouvait une armoire.",
    "Dans sa pièce, il n'y avait qu'elle et Clara.",
    "Elle touchait un mur extérieur de la propriété.",
    "Fabiola et elle étaient sur une même ligne diagonale.",
    "Elle partageait une diagonale avec Bruna.",
    "Elle partageait sa colonne avec un vélo."
