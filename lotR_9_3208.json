  "textos": {
   "ca": [
    "Va passar l'estona a la cuina.",
    "Era al corral.",
    "Era al costat d'una cadira.",
    "Tenia Francesca al seu sud.",
    "A la seva columna hi havia un balancí.",
    "Era a l'oest d'Eudald.",
    "Tenia un carro a tocar.",
    "Era en un racó d'una habitació.",
    "Tenia Dolors al seu oest.",
    "Era al sud de Violant.",
    "A la seva fila hi havia un pou.",
    "Compartia fila amb un balancí.",
    "Era en una altra habitació que Glòria.",
    "Arnau i ella eren en una mateixa línia diagonal."
   ],
   "fr": [
    "Il a passé le temps dans la cuisine.",
    "On l'a vu dans la basse-cour.",
    "Elle avait une chaise tout près.",
    "Elle était au nord de Francesca.",
    "Un fauteuil à bascule se trouvait dans sa colonne.",
    "Elle se trouvait plus à l'ouest qu'Eudald.",
    "Il se tenait près d'une charrette.",
    "Elle occupait un coin d'une pièce.",
    "Il se trouvait plus à l'est que Dolors.",
    "Elle était au sud de Violant.",
    "Sur sa ligne se trouvait un puits.",
    "Elle partageait sa ligne avec un fauteuil à bascule.",
    "Il n'était pas dans la même pièce que Glòria.",
    "Arnau et elle étaient sur une même ligne diagonale."
   ]
