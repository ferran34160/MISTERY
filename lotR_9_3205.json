  "textos": {
   "ca": [
    "Es trobava a la cuina.",
    "Tenia Guillem al seu nord.",
    "Ocupava un racó d'una habitació.",
    "Tenia un pou a la mateixa columna.",
    "Estava a un salt de cavall de Dolors.",
    "Compartia fila amb un rac de vins.",
    "Un armari era a la seva columna.",
    "Un forn era a la seva fila.",
    "Era a la mateixa habitació que Dolors.",
    "Compartia diagonal amb Guillem.",
    "Tenia un armari a la mateixa fila."
   ],
   "fr": [
    "Elle était dans la cuisine.",
    "Il se trouvait plus au sud que Guillem.",
    "Il occupait un coin d'une pièce.",
    "Dans sa colonne se trouvait un puits.",
    "Il se trouvait à un saut de cavalier de Dolors.",
    "Sur sa ligne se trouvait un casier à vins.",
    "Une armoire se trouvait dans sa colonne.",
    "Un four se trouvait sur sa ligne.",
    "Il partageait sa pièce avec Dolors.",
    "Elle était sur la même diagonale que Guillem.",
    "Elle partageait sa ligne avec une armoire."
   ]
