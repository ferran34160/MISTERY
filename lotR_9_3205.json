  "textos": {
   "ca": [
    "Va passar l'estona a la cuina.",
    "Era al sud de Gemma.",
    "Va quedar-se en un racó d'una habitació.",
    "Compartia columna amb un pou.",
    "Era a un salt de cavall de Dolors (com als escacs).",
    "Un rac de vins era a la seva fila.",
    "Tenia un armari a la mateixa columna.",
    "Tenia un forn a la mateixa fila.",
    "Compartia habitació amb Dolors.",
    "Era a la mateixa diagonal que Gemma.",
    "A la seva fila hi havia un armari."
   ],
   "fr": [
    "On l'a vu dans la cuisine.",
    "Il se trouvait plus au sud que Gemma.",
    "Il était dans un coin d'une pièce.",
    "Dans sa colonne se trouvait un puits.",
    "Elle était à un saut de cavalier de Dolors (comme aux échecs).",
    "Sur sa ligne se trouvait un casier à vins.",
    "Il partageait sa colonne avec une armoire.",
    "Un four se trouvait sur sa ligne.",
    "Dolors et lui étaient dans la même pièce.",
    "Elle partageait une diagonale avec Gemma.",
    "Il partageait sa ligne avec une armoire."
   ]
