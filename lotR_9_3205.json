  "textos": {
   "ca": [
    "Un barril era a la seva fila.",
    "Compartia habitació només amb Gerard.",
    "Eulàlia i ell eren a la mateixa habitació.",
    "Estava més a l'oest que Gerard.",
    "Tenia un forn a la mateixa fila.",
    "Tenia un barril a la mateixa columna.",
    "Un balancí era a la seva columna.",
    "Era al celler.",
    "Era a l'oest d'Heura.",
    "Estava més al sud que Berta.",
    "Valentí i ell eren en una mateixa línia diagonal.",
    "Era a un salt de cavall de Clara (com als escacs).",
    "Compartia diagonal amb Dídac.",
    "Tenia Clara al seu oest."
   ],
   "fr": [
    "Sur sa ligne se trouvait un tonneau.",
    "Elle ne partageait sa pièce qu'avec Gerard.",
    "Il partageait sa pièce avec Eulàlia.",
    "Gerard était à l'est de lui.",
    "Elle partageait sa ligne avec un four.",
    "Un tonneau se trouvait dans sa colonne.",
    "Il partageait sa colonne avec un fauteuil à bascule.",
    "Elle était dans le cellier.",
    "Elle se trouvait plus à l'ouest qu'Heura.",
    "Il se trouvait plus au sud que Berta.",
    "Valentí et lui étaient sur une même ligne diagonale.",
    "Il était à un saut de cavalier de Clara (comme aux échecs).",
    "Il partageait une diagonale avec Dídac.",
    "Elle se trouvait plus à l'est que Clara."
   ]
