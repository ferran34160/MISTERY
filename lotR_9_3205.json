  "textos": {
   "ca": [
    "Compartia fila amb un barril.",
    "Compartia habitació només amb Gerard.",
    "Compartia habitació amb Elna.",
    "Estava més a l'oest que Gerard.",
    "Un forn era a la seva fila.",
    "A la seva columna hi havia un barril.",
    "Compartia columna amb un balancí.",
    "Va passar l'estona al celler.",
    "Tenia Hug al seu est.",
    "Tenia Berta al seu nord.",
    "Era a la mateixa diagonal que Valentí.",
    "Respecte a Cesc, estava a un moviment de cavall.",
    "David i ell eren en una mateixa línia diagonal.",
    "Era a l'est de Cesc."
   ],
   "fr": [
    "Sur sa ligne se trouvait un tonneau.",
    "Il ne partageait sa pièce qu'avec Gerard.",
    "Il était dans la même pièce qu'Elna.",
    "Gerard était à l'est de lui.",
    "Un four se trouvait sur sa ligne.",
    "Un tonneau se trouvait dans sa colonne.",
    "Dans sa colonne se trouvait un fauteuil à bascule.",
    "Il se trouvait dans le cellier.",
    "Elle se trouvait plus à l'ouest qu'Hug.",
    "Il était au sud de Berta.",
    "Il était sur la même diagonale que Valentí.",
    "Il se trouvait à un saut de cavalier de Cesc.",
    "David et lui étaient sur une même ligne diagonale.",
    "Cesc était à l'ouest d'elle."
   ]
