  "textos": {
   "ca": [
    "A la seva fila hi havia un barril.",
    "A la seva columna hi havia una cadira.",
    "A la seva fila hi havia un pou.",
    "Era al corral.",
    "Era a la mateixa habitació que Jaume.",
    "Era al costat d'una cadira.",
    "Era al celler.",
    "Era a l'oest de Remei.",
    "Era en un racó d'una habitació.",
    "A la seva columna hi havia una cadira.",
    "Era a un salt de cavall d'Elna (com als escacs).",
    "Era al sud de Teo."
   ],
   "fr": [
    "Sur sa ligne se trouvait un tonneau.",
    "Dans sa colonne se trouvait une chaise.",
    "Sur sa ligne se trouvait un puits.",
    "Il était dans la basse-cour.",
    "Elle était dans la même pièce que Jaume.",
    "Il avait une chaise tout près.",
    "Elle se trouvait dans le cellier.",
    "Elle était à l'ouest de Remei.",
    "Elle était dans un coin d'une pièce.",
    "Dans sa colonne se trouvait une chaise.",
    "Il était à un saut de cavalier d'Elna (comme aux échecs).",
    "Elle était au sud de Teo."
