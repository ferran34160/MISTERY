  "textos": {
   "ca": [
    "Era al costat d'un rac de vins.",
    "Tenia una bicicleta a la mateixa columna.",
    "Tenia Francesca al seu oest.",
    "Un forn era a la seva columna.",
    "Estava al celler.",
    "La van veure al porxo.",
    "Era a un salt de cavall d'Eudald (com als escacs).",
    "Es va deixar caure sobre el carro.",
    "Tenia una bicicleta a la mateixa fila.",
    "Estava a un salt de cavall d'Eudald."
   ],
   "fr": [
    "Elle avait un casier à vins tout près.",
    "Dans sa colonne se trouvait un vélo.",
    "Francesca était à l'ouest d'elle.",
    "Un four se trouvait dans sa colonne.",
    "Elle était dans le cellier.",
    "Elle se trouvait dans le porche.",
    "Par rapport à Eudald, elle était à un mouvement de cavalier.",
    "Elle se tenait sur la charrette.",
    "Sur sa ligne se trouvait un vélo.",
    "Elle se trouvait à un saut de cavalier d'Eudald."
   ]
