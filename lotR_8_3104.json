  "textos": {
   "ca": [
    "Tenia un armari a la mateixa fila.",
    "Estava en una cantonada d'una habitació.",
    "A la seva fila hi havia una bàscula.",
    "Era al costat d'un balancí.",
    "Compartia columna amb una nevera.",
    "Estava més al nord que Enric.",
    "Estava vora un carro.",
    "El porxo només tenia una persona, comptant la víctima.",
    "Compartia diagonal amb Francesca.",
    "No compartia habitació amb Enric.",
    "Tenia Enric al seu nord."
   ],
   "fr": [
    "Elle partageait sa ligne avec une armoire.",
    "Il était dans un coin d'une pièce.",
    "Une balance se trouvait sur sa ligne.",
    "Il était à côté d'un fauteuil à bascule.",
    "Dans sa colonne se trouvait un frigo.",
    "Enric était au sud d'elle.",
    "Il se tenait près d'une charrette.",
    "Le porche ne comptait qu'une personne, victime comprise.",
    "Elle était sur la même diagonale que Francesca.",
    "Elle se trouvait dans une autre pièce qu'Enric.",
    "Il était au sud d'Enric."
   ]
