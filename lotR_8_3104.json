  "textos": {
   "ca": [
    "Tenia un rac de vins a tocar.",
    "Tenia una bicicleta a la mateixa columna.",
    "Estava més a l'est que Fina.",
    "Un forn era a la seva columna.",
    "Es trobava al celler.",
    "Va passar l'estona al porxo.",
    "Respecte a Enric, estava a un moviment de cavall.",
    "Estava damunt el carro.",
    "A la seva fila hi havia una bicicleta.",
    "Era a un salt de cavall d'Enric (com als escacs)."
   ],
   "fr": [
    "Il avait un casier à vins tout près.",
    "Dans sa colonne se trouvait un vélo.",
    "Elle se trouvait plus à l'est que Fina.",
    "Elle partageait sa colonne avec un four.",
    "Elle était dans le cellier.",
    "On l'a vu dans le porche.",
    "Par rapport à Enric, elle était à un mouvement de cavalier.",
    "Il se tenait sur la charrette.",
    "Il partageait sa ligne avec un vélo.",
    "Il se trouvait à un saut de cavalier d'Enric."
   ]
