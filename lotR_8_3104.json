  "textos": {
   "ca": [
    "Un armari era a la seva fila.",
    "Va quedar-se en un racó d'una habitació.",
    "Compartia fila amb una bàscula.",
    "Era al costat d'un balancí.",
    "Una nevera era a la seva columna.",
    "Era al nord d'Elna.",
    "Tenia un carro a tocar.",
    "El porxo només tenia una persona, comptant la víctima.",
    "Fina i ell eren en una mateixa línia diagonal.",
    "No compartia habitació amb Elna.",
    "Era al sud d'Elna."
   ],
   "fr": [
    "Une armoire se trouvait sur sa ligne.",
    "Il occupait un coin d'une pièce.",
    "Il partageait sa ligne avec une balance.",
    "Il était à côté d'un fauteuil à bascule.",
    "Dans sa colonne se trouvait un frigo.",
    "Elna était au sud d'elle.",
    "Il avait une charrette tout près.",
    "Le porche ne comptait qu'une personne, victime comprise.",
    "Il partageait une diagonale avec Fina.",
    "Il n'était pas dans la même pièce qu'Elna.",
    "Il se trouvait plus au sud qu'Elna."
   ]
