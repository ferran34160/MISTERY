  "textos": {
   "ca": [
    "Una bicicleta era a la seva columna.",
    "Es trobava a la sala.",
    "Era al sud d'Elna.",
    "Estava al celler.",
    "Tenia Carla al seu est.",
    "Compartia fila amb una pica.",
