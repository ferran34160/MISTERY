  "textos": {
   "ca": [
    "Era al costat d'un armari.",
    "A la seva columna hi havia una cadira.",
    "A la seva fila hi havia un pou.",
    "Era sobre el carro.",
    "Només ell i Teo eren a la seva habitació.",
    "A la seva columna hi havia una cadira.",
    "Era a la mateixa diagonal que Marçal.",
    "Era a la mateixa habitació que Remei.",
    "Era al nord de Blai.",
    "Era a un salt de cavall d'Elna (com als escacs).",
    "Era a la mateixa diagonal que Elna.",
    "Era al nord de Jaume."
   ],
   "fr": [
    "Il avait une armoire tout près.",
    "Dans sa colonne se trouvait une chaise.",
    "Sur sa ligne se trouvait un puits.",
    "Elle était sur la charrette.",
    "Seuls lui et Teo étaient dans sa pièce.",
    "Dans sa colonne se trouvait une chaise.",
    "Elle était sur la même diagonale que Marçal.",
    "Elle était dans la même pièce que Remei.",
    "Il était au nord de Blai.",
    "Il était à un saut de cavalier d'Elna (comme aux échecs).",
    "Il était sur la même diagonale qu'Elna.",
    "Il était au nord de Jaume."
   ]
