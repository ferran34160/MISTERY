  "textos": {
   "ca": [
    "Era a l'est de Jaume.",
    "Era a l'oest d'Aina.",
    "A la seva columna hi havia una taula.",
    "A la seva fila hi havia una cadira.",
    "No era a la mateixa habitació que Quim.",
    "Era a un salt de cavall de Teo (com als escacs).",
    "A la seva fila hi havia una taula.",
    "A la seva columna hi havia un pou.",
    "Era al nord de Blai.",
    "Era al sud de Neus.",
    "Era a la mateixa diagonal que Jaume.",
    "A la seva columna hi havia un armari.",
    "Era en un racó d'una habitació.",
    "Era a la mateixa habitació que Elna.",
    "Hi havia exactament 3 persones a la cuina, víctima inclosa."
   ],
   "fr": [
    "Il était à l'est de Jaume.",
    "Elle était à l'ouest d'Aina.",
    "Dans sa colonne se trouvait une table.",
    "Sur sa ligne se trouvait une chaise.",
    "Elle n'était pas dans la même pièce que Quim.",
    "Elle était à un saut de cavalier de Teo (comme aux échecs).",
    "Sur sa ligne se trouvait une table.",
    "Dans sa colonne se trouvait un puits.",
    "Elle était au nord de Blai.",
    "Elle était au sud de Neus.",
    "Elle était sur la même diagonale que Jaume.",
    "Dans sa colonne se trouvait une armoire.",
    "Il était dans un coin d'une pièce.",
    "Elle était dans la même pièce qu'Elna.",
    "Il y avait exactement 3 personnes dans la cuisine, victime comprise."
   ]
