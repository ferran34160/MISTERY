   "ca": [
    "Era al costat d'un carro.",
    "Estava a la cuina.",
    "Era a l'oest d'Elna.",
    "No era al porxo.",
    "Era al nord d'Elna.",
    "Era al costat d'un armari.",
    "Era al porxo.",
    "Era al sud de Blai.",
    "A la seva columna hi havia un barril.",
    "Era a la mateixa habitació que Quim.",
    "Era al celler.",
    "Era al nord d'Elna.",
    "Era a la mateixa diagonal que Elna.",
    "Era a un salt de cavall de Neus (com als escacs)."
